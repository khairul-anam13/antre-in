# Database lokal (Postgres). Produksi: connection string Supabase/Neon (pakai pooler, ?sslmode=require)
DATABASE_URL=postgres://antre@127.0.0.1:5433/antre_in

# URL publik aplikasi (dipakai untuk callback Google & Midtrans)
APP_URL=http://localhost:3000

# Login Google pelanggan (opsional; kosong = tombol Google nonaktif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Midtrans (kosong = mode simulasi, hanya jalan di development)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Web push (kunci dev; buat sendiri untuk produksi: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BEaOna9Yp2nXH0dCQuuOP4Tvvz2hD7vteom5ts8Bx4F_sFdEVQVyunEnvBb1wRVwiSEDnK_uYfIKNfbY-ZfY3hQ
VAPID_PRIVATE_KEY=<isi di .env.local>
VAPID_SUBJECT=mailto:admin@antre.in

# Akun admin awal, dibuat oleh: npm run db -- admin
ADMIN_EMAIL=admin@antre.in
ADMIN_PASSWORD=<isi di .env.local>
